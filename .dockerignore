# Keep the build context small and free of local state (build context: repository root)
.git
.claude
prd
run
**/node_modules
**/venv*
**/__pycache__
**/*.pyc
web/dist
backend/application/dist
backend/application/dist.zip
backend/config.json
backend/*.db
backend/*.db.bak
backend/*.sqlite
backend/application/plugins/*.sqlite
backend/dump.rdb
backend/*.log
backend/hardcopy.*
backend/database/*
!backend/database/empty
backend/data/cached-monitoring-images/*
backend/data/pin-avatars/*
!backend/data/**/empty
