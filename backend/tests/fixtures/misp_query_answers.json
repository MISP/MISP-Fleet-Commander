 "error_several": {
  "about": "SELECT * FROM attributes WHERE bogus = 1 AND id = 'x' AND type LIKE 'a%b' AND NOT (value IN (1)) LIMIT 1",
  "request": {
   "method": "POST",
   "path": "/attributes/restSearch",
   "body": {
    "returnFormat": "json",
    "limit": 1,
    "page": 1,
    "query": {
     "AND": [
      {
       "bogus": 1
      },
      {
       "id": "x"
      },
      {
       "type": {
        "LIKE": "a%b"
       }
      },
      {
       "NOT": {
        "value": {
         "IN": [
          1
         ]
        }
       }
      }
     ]
    }
   }
  },
  "status": 400,
  "headers": {
   "Content-Type": "application/json; charset=UTF-8"
  },
  "body": {
   "name": "Invalid query",
   "message": "4 errors",
   "url": "/attributes/restSearch",
   "errors": [
    {
     "path": "query.AND[0].<unknown>",
     "code": "unknown_field",
     "message": "unknown field"
    },
    {
     "path": "query.AND[1].id",
     "code": "bad_type",
     "message": "this field expects an integer"
    },
    {
     "path": "query.AND[2].type",
     "code": "bad_type",
     "message": "LIKE takes a leading and/or trailing %, nothing else"
    },
    {
     "path": "query.AND[3].NOT.value",
     "code": "bad_type",
     "message": "this field expects a non-empty string"
    }
   ]
  }
 },
