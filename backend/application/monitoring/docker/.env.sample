# Copy to .env and replace every change-me value before the first `docker compose up`.
# The InfluxDB values are only used to initialise a new InfluxDB volume.
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=change-me
DOCKER_INFLUXDB_INIT_ORG=org
DOCKER_INFLUXDB_INIT_BUCKET=MISP-Fleet-Commander
# Generate one with: openssl rand -base64 64 | tr -d '\n'
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=change-me
DOCKER_GRAFANA_USERNAME=admin
DOCKER_GRAFANA_PASSWORD=change-me
